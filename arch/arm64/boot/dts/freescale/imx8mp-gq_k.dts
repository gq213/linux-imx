#include "imx8mp-gq.dts"

/ {
	model = "NXP i.MX8MPlus gq_k board";
	compatible = "fsl,imx8mp-gq", "fsl,imx8mp";

	chosen {
		stdout-path = &uart1;
	};

	gpio-leds {
		status {
			/delete-property/ default-state;
			linux,default-trigger = "heartbeat";
		};

		core@2 {
			label = "core_2";
			gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		evm@1 {
			label = "evm_1";
			gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "mmc1"; /* SD */
			default-state = "off";
		};

		usb2@1 {
			label = "usb2_1";
			gpios = <&gpio4 28 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		usb2@2 {
			label = "usb2_2";
			gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		usb2@3 {
			label = "usb2_3";
			gpios = <&gpio5 5 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0 0xc0000000>,
		      <0x1 0x00000000 0 0x40000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		// autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_gpio_key>;

		evm@0 {
			label = "evm_0";
			linux,code = <KEY_ESC>;
			debounce-interval = <100>;
			gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
		};
	};

	pwm_fan {
		compatible = "pwm-fan";
		cooling-min-state = <0>;
		cooling-max-state = <3>;
		#cooling-cells = <2>;
		pwms = <&pwm4 0 50000 0>;
		cooling-levels = <0 102 170 230>;
	};

	sound-sai {
		compatible = "simple-audio-card";
		simple-audio-card,name = "TLV320AIC3x-Card";
		simple-audio-card,format = "dsp_b";
		simple-audio-card,bitclock-inversion;
		simple-audio-card,frame-master = <&dailink_master>;
		simple-audio-card,bitclock-master = <&dailink_master>;
		simple-audio-card,widgets =
			"Line", "Line In Jack",
			"Line", "Line Out Jack";
		simple-audio-card,routing =
			"LINE1L", "Line In Jack",
			"LINE1R", "Line In Jack",
			"Line Out Jack", "LLOUT",
			"Line Out Jack", "RLOUT";

		simple-audio-card,cpu {
			sound-dai = <&sai3>;
		};

		dailink_master: simple-audio-card,codec {
			sound-dai = <&tlv320aic3106>;
			clocks = <&audio_blk_ctrl IMX8MP_CLK_AUDIOMIX_SAI3_MCLK1>;
		};
	};
};

/* ETH1 up */
&eqos {
	local-mac-address = [00 26 22 d9 fa 31];
};

&ethphy0 {
    reset-gpios = <&gpio4 0 GPIO_ACTIVE_LOW>;
    reset-assert-us = <50000>;
    reset-deassert-us = <50000>;
    /delete-property/ realtek,clkout-disable;
    motorcomm,auto-sleep-disabled;
    motorcomm,keep-pll-enabled;
	// tx-internal-delay-ps = <1200>;
	// rx-internal-delay-ps = <0>;
};

/* ETH0 bottom */
&fec {
	local-mac-address = [00 26 22 d9 fa 30];
};

&ethphy1 {
    reg = <0>;
    reset-gpios = <&gpio4 24 GPIO_ACTIVE_LOW>;
    reset-assert-us = <50000>;
    reset-deassert-us = <50000>;
    /delete-property/ realtek,aldps-enable;
    /delete-property/ realtek,clkout-disable;
    motorcomm,auto-sleep-disabled;
    motorcomm,keep-pll-enabled;
	// tx-internal-delay-ps = <150>;
	// rx-internal-delay-ps = <0>;
};

&flexcan1 {
	/delete-property/ xceiver-supply;
};

&flexcan2 {
	/delete-property/ xceiver-supply;
	/delete-property/ pinctrl-assert-gpios;
	status = "okay";
};

&i2c1 {
	clock-frequency = <100000>;

	rtc@68 {
		compatible = "dallas,ds1307";
		reg = <0x68>;
	};

	tlv320aic3106: codec@18 {
		compatible = "ti,tlv320aic3106";
		reg = <0x18>;
		#sound-dai-cells = <0>;
		ai3x-ocmv = <1>; /* Output Common-Mode Voltage 1.5V */
		ai3x-micbias-vg = <2>; /* MICBIAS output is powered to 2.5V */
	};
};

&i2c2 {
	clock-frequency = <100000>;

	extcon_usb0: wusb3801@60 {
		compatible = "extcon,wusb3801";
		reg = <0x60>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_usb0_extcon>;
		interrupt-parent = <&gpio4>;
		interrupts = <22 IRQ_TYPE_LEVEL_LOW>;
		id-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		vbus-gpios = <&gpio4 21 GPIO_ACTIVE_HIGH>;
		sel-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;

		port {
			typec_dr_sw: endpoint {
				remote-endpoint = <&usb3_drd_sw>;
			};
		};
	};
};

&mipi_dsi {
	/delete-node/ port@1;
	panel@0 {
		compatible = "lontium,lt8912b-hdmi";
		reg = <0>;
	};
};

&pcie_phy {
	status = "okay";
};

&pcie0 {
	reset-gpio = <&gpio2 11 GPIO_ACTIVE_LOW>;
	/delete-property/ host-wake-gpio;
	/delete-property/ vpcie-supply;
	/delete-property/ supports-clkreq;
	status = "okay";
};

&sai3 {
	assigned-clock-rates = <24576000>;
};

&uart1 {
	/delete-property/ assigned-clocks;
	/delete-property/ assigned-clock-parents;
	/delete-property/ uart-has-rtscts;

    /delete-node/ bluetooth;
};

&usb_dwc3_1 {
	/delete-property/ vbus-supply;
};

&uart3 {
	/delete-property/ assigned-clocks;
	/delete-property/ assigned-clock-parents;
	/delete-property/ uart-has-rtscts;
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>;
	status = "okay";
};

&reg_usdhc2_vmmc {
	off-on-delay-us = <100000>;
	startup-delay-us = <20000>;
	regulator-always-on;
};

/* SD */
&usdhc2 {
	cap-sd-highspeed;
	cap-mmc-highspeed;
	// sd-uhs-sdr12;
	// sd-uhs-sdr25;
	sdhci-caps-mask = <0x7 0x0>;
	// no-1-8-v;
	status = "okay";
};

/* eMMC */
&usdhc3 {
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	status = "okay";
};

&iomuxc {
	pinctrl-0 = <&pinctrl_hog &pinctrl_hw_wdog &pinctrl_isolate_io>;

	pinctrl_eqos: eqosgrp {
		fsl,pins = <
			MX8MP_IOMUXC_ENET_MDC__ENET_QOS_MDC				0x2
			MX8MP_IOMUXC_ENET_MDIO__ENET_QOS_MDIO				0x2
			MX8MP_IOMUXC_ENET_RD0__ENET_QOS_RGMII_RD0			0x90
			MX8MP_IOMUXC_ENET_RD1__ENET_QOS_RGMII_RD1			0x90
			MX8MP_IOMUXC_ENET_RD2__ENET_QOS_RGMII_RD2			0x90
			MX8MP_IOMUXC_ENET_RD3__ENET_QOS_RGMII_RD3			0x90
			MX8MP_IOMUXC_ENET_RXC__CCM_ENET_QOS_CLOCK_GENERATE_RX_CLK	0x90
			MX8MP_IOMUXC_ENET_RX_CTL__ENET_QOS_RGMII_RX_CTL			0x90
			MX8MP_IOMUXC_ENET_TD0__ENET_QOS_RGMII_TD0			0x16
			MX8MP_IOMUXC_ENET_TD1__ENET_QOS_RGMII_TD1			0x16
			MX8MP_IOMUXC_ENET_TD2__ENET_QOS_RGMII_TD2			0x16
			MX8MP_IOMUXC_ENET_TD3__ENET_QOS_RGMII_TD3			0x16
			MX8MP_IOMUXC_ENET_TX_CTL__ENET_QOS_RGMII_TX_CTL			0x16
			MX8MP_IOMUXC_ENET_TXC__CCM_ENET_QOS_CLOCK_GENERATE_TX_CLK	0x16
			MX8MP_IOMUXC_SAI1_RXFS__GPIO4_IO00				0x10
		>;
	};

	pinctrl_fec: fecgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI1_RXD2__ENET1_MDC		0x2
			MX8MP_IOMUXC_SAI1_RXD3__ENET1_MDIO		0x2
			MX8MP_IOMUXC_SAI1_RXD4__ENET1_RGMII_RD0		0x90
			MX8MP_IOMUXC_SAI1_RXD5__ENET1_RGMII_RD1		0x90
			MX8MP_IOMUXC_SAI1_RXD6__ENET1_RGMII_RD2		0x90
			MX8MP_IOMUXC_SAI1_RXD7__ENET1_RGMII_RD3		0x90
			MX8MP_IOMUXC_SAI1_TXC__ENET1_RGMII_RXC		0x90
			MX8MP_IOMUXC_SAI1_TXFS__ENET1_RGMII_RX_CTL	0x90
			MX8MP_IOMUXC_SAI1_TXD0__ENET1_RGMII_TD0		0x16
			MX8MP_IOMUXC_SAI1_TXD1__ENET1_RGMII_TD1		0x16
			MX8MP_IOMUXC_SAI1_TXD2__ENET1_RGMII_TD2		0x16
			MX8MP_IOMUXC_SAI1_TXD3__ENET1_RGMII_TD3		0x16
			MX8MP_IOMUXC_SAI1_TXD4__ENET1_RGMII_TX_CTL	0x16
			MX8MP_IOMUXC_SAI1_TXD5__ENET1_RGMII_TXC		0x16
			MX8MP_IOMUXC_SAI2_TXFS__GPIO4_IO24		0x10
		>;
	};

	pinctrl_flexcan2: flexcan2grp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI2_MCLK__CAN2_RX         0x154
			MX8MP_IOMUXC_SAI2_TXD0__CAN2_TX         0x154
		>;
	};

	pinctrl_gpio_led: gpioledgrp {
		fsl,pins = <
			MX8MP_IOMUXC_NAND_READY_B__GPIO3_IO16	0x140
			MX8MP_IOMUXC_GPIO1_IO00__GPIO1_IO00		0x140
			MX8MP_IOMUXC_GPIO1_IO05__GPIO1_IO05		0x140
			MX8MP_IOMUXC_SAI3_RXFS__GPIO4_IO28		0x140
			MX8MP_IOMUXC_GPIO1_IO06__GPIO1_IO06		0x140
			MX8MP_IOMUXC_SPDIF_EXT_CLK__GPIO5_IO05	0x140
		>;
	};

	pinctrl_hog: hoggrp {
		fsl,pins = <
			MX8MP_IOMUXC_HDMI_DDC_SCL__HDMIMIX_HDMI_SCL	0x400001c2
			MX8MP_IOMUXC_HDMI_DDC_SDA__HDMIMIX_HDMI_SDA	0x400001c2
			MX8MP_IOMUXC_HDMI_HPD__HDMIMIX_HDMI_HPD		0x40000010
			MX8MP_IOMUXC_HDMI_CEC__HDMIMIX_HDMI_CEC		0x40000010
		>;
	};

	pinctrl_pcie0: pcie0grp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_STROBE__GPIO2_IO11	0x40
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX8MP_IOMUXC_UART1_RXD__UART1_DCE_RX	0x140
			MX8MP_IOMUXC_UART1_TXD__UART1_DCE_TX	0x140
		>;
	};

	pinctrl_uart3: uart3grp {
		fsl,pins = <
			MX8MP_IOMUXC_UART3_TXD__UART3_DCE_TX		0x140
			MX8MP_IOMUXC_UART3_RXD__UART3_DCE_RX		0x140
		>;
	};

	pinctrl_usdhc2_100mhz: usdhc2-100mhzgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK	0x190
			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD	0x1d0
			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d0
			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d0
			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d0
			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d0
			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
		>;
	};

	pinctrl_usdhc2_200mhz: usdhc2-200mhzgrp {
		fsl,pins = <
			MX8MP_IOMUXC_SD2_CLK__USDHC2_CLK	0x190
			MX8MP_IOMUXC_SD2_CMD__USDHC2_CMD	0x1d0
			MX8MP_IOMUXC_SD2_DATA0__USDHC2_DATA0	0x1d0
			MX8MP_IOMUXC_SD2_DATA1__USDHC2_DATA1	0x1d0
			MX8MP_IOMUXC_SD2_DATA2__USDHC2_DATA2	0x1d0
			MX8MP_IOMUXC_SD2_DATA3__USDHC2_DATA3	0x1d0
			MX8MP_IOMUXC_GPIO1_IO04__USDHC2_VSELECT 0xc0
		>;
	};

	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <
			MX8MP_IOMUXC_NAND_WE_B__USDHC3_CLK	0x196
			MX8MP_IOMUXC_NAND_WP_B__USDHC3_CMD	0x1d6
			MX8MP_IOMUXC_NAND_DATA04__USDHC3_DATA0	0x1d6
			MX8MP_IOMUXC_NAND_DATA05__USDHC3_DATA1	0x1d6
			MX8MP_IOMUXC_NAND_DATA06__USDHC3_DATA2	0x1d6
			MX8MP_IOMUXC_NAND_DATA07__USDHC3_DATA3	0x1d6
			MX8MP_IOMUXC_NAND_RE_B__USDHC3_DATA4	0x1d6
			MX8MP_IOMUXC_NAND_CE2_B__USDHC3_DATA5	0x1d6
			MX8MP_IOMUXC_NAND_CE3_B__USDHC3_DATA6	0x1d6
			MX8MP_IOMUXC_NAND_CLE__USDHC3_DATA7	0x1d6
			MX8MP_IOMUXC_NAND_CE1_B__USDHC3_STROBE	0x196
		>;
	};

	pinctrl_usdhc3_100mhz: usdhc3-100mhzgrp {
		fsl,pins = <
			MX8MP_IOMUXC_NAND_WE_B__USDHC3_CLK	0x196
			MX8MP_IOMUXC_NAND_WP_B__USDHC3_CMD	0x1d6
			MX8MP_IOMUXC_NAND_DATA04__USDHC3_DATA0	0x1d6
			MX8MP_IOMUXC_NAND_DATA05__USDHC3_DATA1	0x1d6
			MX8MP_IOMUXC_NAND_DATA06__USDHC3_DATA2	0x1d6
			MX8MP_IOMUXC_NAND_DATA07__USDHC3_DATA3	0x1d6
			MX8MP_IOMUXC_NAND_RE_B__USDHC3_DATA4	0x1d6
			MX8MP_IOMUXC_NAND_CE2_B__USDHC3_DATA5	0x1d6
			MX8MP_IOMUXC_NAND_CE3_B__USDHC3_DATA6	0x1d6
			MX8MP_IOMUXC_NAND_CLE__USDHC3_DATA7	0x1d6
			MX8MP_IOMUXC_NAND_CE1_B__USDHC3_STROBE	0x196
		>;
	};

	pinctrl_gpio_key: gpiokeygrp {
		fsl,pins = <
			MX8MP_IOMUXC_GPIO1_IO01__GPIO1_IO01	0x00000106
		>;
	};

	pinctrl_usb0_extcon: usb0grp {
		fsl,pins = <
			MX8MP_IOMUXC_SAI2_RXC__GPIO4_IO22	0x1c4
			MX8MP_IOMUXC_GPIO1_IO10__GPIO1_IO10	0x1c4
			MX8MP_IOMUXC_SAI2_RXFS__GPIO4_IO21	0x10
			MX8MP_IOMUXC_GPIO1_IO07__GPIO1_IO07	0x10
		>;
	};

	pinctrl_uart4: uart4grp {
		fsl,pins = <
			MX8MP_IOMUXC_UART4_TXD__UART4_DCE_TX		0x140
			MX8MP_IOMUXC_UART4_RXD__UART4_DCE_RX		0x140
		>;
	};

	pinctrl_hw_wdog: hw_wdoggrp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_DATA6__GPIO2_IO08	0x00000106	/* WDOG_WDI  */
			MX8MP_IOMUXC_SD1_DATA7__GPIO2_IO09	0x00000106	/* WDOG_SET */
		>;
	};

	pinctrl_isolate_io: isolate_iogrp {
		fsl,pins = <
			MX8MP_IOMUXC_SD1_DATA2__GPIO2_IO04	0x00000106	/* DO1 - 36 */
			MX8MP_IOMUXC_SD1_CLK__GPIO2_IO00	0x00000106	/* DI1 - 32 */
			MX8MP_IOMUXC_SD1_DATA3__GPIO2_IO05	0x00000106	/* DO2 - 37 */
			MX8MP_IOMUXC_SD1_CMD__GPIO2_IO01	0x00000106	/* DI2 - 33 */
			MX8MP_IOMUXC_SD1_DATA4__GPIO2_IO06	0x00000106	/* DO3 - 38 */
			MX8MP_IOMUXC_SD1_DATA0__GPIO2_IO02	0x00000106	/* DI3 - 34 */
			MX8MP_IOMUXC_SD1_DATA5__GPIO2_IO07	0x00000106	/* DO4 - 39 */
			MX8MP_IOMUXC_SD1_DATA1__GPIO2_IO03	0x00000106	/* DI4 - 35 */
		>;
	};
};
